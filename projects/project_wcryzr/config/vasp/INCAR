SYSTEM = Elastic constant calculation (stage 1 - pre-processing)

PREC = Accurate # Precision
NCORE = 8
KPAR = 4

LORBIT = 11 # Determines whether PROCAR or PROOUT files are written
LREAL = .FALSE. # Whether projection operators are evaluated in real or k-space (default = FALSE)
LASPH = .TRUE. # Include non-spherical contributions related to the gradient of the density in PAW spheres
LAECHG = .FALSE.

KSPACING = 0.22 # Automatic k-point spacing (no KPOINTS file needed)
KGAMMA = .TRUE. # Include Gamma point in the mesh

ISPIN = 2
ISMEAR = 0 # Determines how partical occupancies f_{nk} are set for each orbital. 0 = gaussian,-1 = fermi, etc.
SIGMA = 0.05
LSORBIT = .FALSE. # Spin-orbit coupling

