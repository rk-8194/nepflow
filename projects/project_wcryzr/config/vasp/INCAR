ENCUT = 520 # Cutoff energy, need to perform convergence on this.
ENAUG = 1360
NELM = 200 # Maximum number of selfconsistency (SC) steps which may be performed
EDIFF = 1E-05 # Global break conditions for electrons in the SC-loop

LMAXMIX = 6 # Controls up to which l-quantum number the one-center PAW charge densities are passed through the charge density mixer
LMIXTAU = .TRUE.
GGA = PE # Type of generalized-gradient-approximation XC functional, e.g. PS = revised Perdew-Berke-Ernzerhof

LDAU = .FALSE.
LDAUTYPE = 2

IBRION = -1 # Determines how ions are updated + moved.
NSW = 0 # Maximum number of ionic steps
EDIFFG = -1E-02 # Ionic convergence
ISIF = 2 # Number of degrees of freedom

LWAVE = F
LCHARGE = F 