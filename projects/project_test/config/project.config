# Project Configuration File
# Project: test

[project]
name=test
description=NEPFlow project for atomic structure generation and validation
status=initialized

[paths]
structures_path=structures
vasp_path=vasp
nep_path=nep
gpumd_path=gpumd
reports_path=reports

[materialsproject]
# Materials Project API key - get from https://next-gen.materialsproject.org/dashboard
# Can also be set via MP_API_KEY environment variable
api_key=XeW06kk3teAkzzmKEybD3CHVMA49MNXj

[generation]
# Elements to include in structure generation (comma-separated)
elements=W,Cr,C

# Crystal structures to include (comma-separated)
# Options: bcc, fcc, hcp, diamond, simple_cubic, body_centered_cubic, face_centered_cubic, hexagonal_close_packed
crystal_structures=bcc,fcc,hcp,diamond,simple_cubic

[vasp]
# VASP calculation settings
enabled=true

[nep]
# NEP model training settings
enabled=true

[gpumd]
# GPUMD validation settings
enabled=true

[slurm]
# SLURM job submission settings
enabled=false
